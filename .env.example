# Configuração de Banco de Dados SQL (PostgreSQL / Supabase / Neon / Local)
# Substitua com sua string de conexão real
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pacelab?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pacelab?schema=public"

# Supabase (Opcional caso utilize autenticação ou storage do Supabase)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon"
