generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum ActivityType {
  corrida_continua
  corrida_intervalada
  caminhada

  @@map("activity_type")
}

enum LocationType {
  pista_400m
  rua_plana
  parque_praca
  esteira
  outro

  @@map("location_type")
}

// 1. Metas do TAF
model TafGoal {
  id                    String    @id @default(uuid())
  userId                String?   @map("user_id")
  institutionName       String?   @default("Edital Padrão") @map("institution_name")
  
  // Corrida (Tempo e Distâncias)
  minDistanceMeters     Int       @default(2400) @map("min_distance_meters")
  targetDistanceMeters  Int       @default(2600) @map("target_distance_meters")
  targetDurationMinutes Int       @default(12) @map("target_duration_minutes")
  targetExamDate        DateTime? @map("target_exam_date")

  // Barra Fixa
  pullupType            String?   @default("dinamica") @map("pullup_type") // "dinamica" | "isometria"
  pullupMinReps         Int?      @default(3) @map("pullup_min_reps")
  pullupTargetReps      Int?      @default(5) @map("pullup_target_reps")
  pullupMinSeconds      Int?      @map("pullup_min_seconds")
  pullupTargetSeconds   Int?      @map("pullup_target_seconds")

  // Flexão de Braço
  pushupMinReps         Int?      @default(20) @map("pushup_min_reps")
  pushupTargetReps      Int?      @default(30) @map("pushup_target_reps")
  pushupDurationSeconds Int?      @map("pushup_duration_seconds")

  // Abdominal
  absMinReps            Int?      @default(30) @map("abs_min_reps")
  absTargetReps         Int?      @default(40) @map("abs_target_reps")
  absDurationSeconds    Int?      @map("abs_duration_seconds")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("taf_goals")
}

// 2. Tentativas de Teste do TAF (12 minutos ou duração personalizada)
model TafAttempt {
  id                    String        @id @default(uuid())
  userId                String?       @map("user_id")
  testDate              DateTime      @default(now()) @map("test_date")
  targetDurationSeconds Int           @default(720) @map("target_duration_seconds")
  actualDurationSeconds Int           @map("actual_duration_seconds")
  distanceMeters        Int           @map("distance_meters")
  speedKmh              Float         @map("speed_kmh")
  paceSeconds           Int           @map("pace_seconds")
  paceFormatted         String        @map("pace_formatted")
  locationType          LocationType? @map("location_type")
  notes                 String?       @map("notes")
  laps                  Json?         @default("[]")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@index([userId, testDate(sort: Desc)])
  @@index([userId, targetDurationSeconds])
  @@map("taf_attempts")
}

// 3. Diário de Treinos
model TrainingSession {
  id              String       @id @default(uuid())
  userId          String?      @map("user_id")
  sessionDate     DateTime     @default(now()) @map("session_date")
  activityType    ActivityType @default(corrida_continua) @map("activity_type")
  distanceKm      Float        @map("distance_km")
  durationSeconds Int          @map("duration_seconds")
  speedKmh        Float        @map("speed_kmh")
  paceSeconds     Int          @map("pace_seconds")
  paceFormatted   String       @map("pace_formatted")
  perceivedEffort Int?         @map("perceived_effort") // RPE 1 a 10
  bodyWeightKg    Float?       @map("body_weight_kg")
  notes           String?      @map("notes")
  splits          Json?        @default("[]")
  // Métricas de Gasto Calórico (Compêndio 2024)
  activeCalories  Float?       @map("active_calories")
  totalCalories   Float?       @map("total_calories")
  metValue        Float?       @map("met_value")
  calorieMethod   String?      @map("calorie_method")
  calorieSource   String?      @map("calorie_source")
  calorieMetadata Json?        @map("calorie_metadata")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([userId, sessionDate(sort: Desc)])
  @@index([userId, activityType])
  @@map("training_sessions")
}

// 4. Perfil do Atleta
model UserProfile {
  id              String         @id @default(uuid())
  userId          String?        @unique @map("user_id")
  name            String?        @map("name")
  heightCm        Float?         @map("height_cm")
  currentWeightKg Float?         @map("current_weight_kg")
  birthDate       DateTime?      @map("birth_date")
  gender          String?        @map("gender")
  weightRecords   WeightRecord[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("user_profiles")
}

// 5. Histórico de Pesagens
model WeightRecord {
  id         String      @id @default(uuid())
  profileId  String      @map("profile_id")
  profile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  weightKg   Float       @map("weight_kg")
  recordedAt DateTime    @default(now()) @map("recorded_at")
  notes      String?     @map("notes")
  source     String?     @default("manual") @map("source")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([profileId, recordedAt(sort: Desc)])
  @@map("weight_records")
}

