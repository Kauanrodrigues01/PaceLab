{
  "name": "pacelab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "db:check": "node --env-file=.env scripts/check-db.mjs",
    "gpx:inspect": "tsx scripts/gpx-inspect.mjs",
    "gpx:test:synthetic": "tsx scripts/gpx-inspect.mjs --synthetic-suite",
    "gpx:test:real": "tsx scripts/gpx-inspect.mjs --real-suite",
    "gpx:gen-fixtures": "node scripts/gen-gpx-fixture.mjs --generate-all",
    "fit:inspect": "tsx scripts/fit-inspect.mjs",
    "fit:test:synthetic": "tsx scripts/fit-inspect.mjs --synthetic-suite",
    "fit:test:real": "tsx scripts/fit-inspect.mjs --real-suite",
    "fit:gen-fixtures": "node scripts/gen-fit-fixture.mjs --generate-all"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.221.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.109.0",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^0.441.0",
    "next": "14.2.35",
    "next-themes": "^0.3.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.7",
    "swagger-ui-dist": "^5.33.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/swagger-ui-dist": "^3.30.6",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^24.1.3",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^1.6.0"
  }
}
